# Configuracao do Gerador PAC Completo IBGE
# Copie este arquivo para .env e preencha suas credenciais

# === WK RADAR API ===
# Token de autenticacao da API do WK Radar
WK_TOKEN=seu_token_aqui

# URL base da API do WK Radar (opcional - padrao abaixo)
WK_API_URL=https://api.wk.com.br/api/v1

# ID da empresa no WK Radar (se necessario)
WK_EMPRESA_ID=

# === CONFIGURACAO GERAL ===
# Ano de referencia do PAC
PAC_ANO=2025

# Arquivo de saida do CSV
PAC_ARQUIVO_SAIDA=pac_2025.csv

# Caminho do arquivo de configuracao de contas (opcional)
WK_CONTAS_CONFIG=wk_contas_config.json
